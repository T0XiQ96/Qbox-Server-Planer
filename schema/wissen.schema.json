{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wissens-Artikel",
  "_hinweis": [
    "Die Wissens-Datenbank ist DATEN, kein App-Code (Entscheidung D1/D28): ein neuer Artikel",
    "darf niemals eine Änderung in src/ erfordern. Deshalb liegen Kategorien in",
    "data/wissen/kategorien.json und Artikel in data/wissen/*.json.",
    "",
    "Die Qualitätsstufen bedeuten hier dasselbe wie im Plugin-Katalog (D7/D18):",
    "  ungeprueft   — aus Erfahrungswissen geschrieben, KEINE Quelle geprüft. Startzustand.",
    "  teilgeprueft — teilweise gegen eine Quelle abgeglichen, Rest offen.",
    "  verifiziert  — gegen die genannten Quellen geprüft, mit Datum in geprueft_am.",
    "Ein Artikel ohne Quellen darf NIE 'verifiziert' sein — das prüft der Validator."
  ],
  "type": "object",
  "required": ["schemaVersion", "artikel"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "number" },
    "artikel": {
      "type": "array",
      "items": { "$ref": "#/definitions/artikel" }
    }
  },
  "definitions": {
    "artikel": {
      "type": "object",
      "required": ["id", "kategorie", "titel", "kurz", "abschnitte", "qualitaet"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "eindeutig über alle Wissensdateien hinweg"
        },
        "kategorie": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "id aus data/wissen/kategorien.json"
        },
        "titel": { "type": "string", "minLength": 3 },
        "kurz": {
          "type": "string",
          "minLength": 10,
          "description": "ein Satz: worum geht es und wann brauche ich das"
        },
        "stichworte": {
          "type": "array",
          "items": { "type": "string" },
          "description": "zusätzliche Suchbegriffe, die nicht im Text stehen"
        },
        "abschnitte": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/abschnitt" }
        },
        "warnung": {
          "type": ["string", "null"],
          "description": "der eine Fehler, den man hier typischerweise macht"
        },
        "siehe_auch": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "description": "ids anderer Wissens-Artikel"
        },
        "plugins": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "description": "ids aus dem Plugin-Katalog, auf die der Artikel verweist"
        },
        "quellen": {
          "type": "array",
          "items": { "type": "string" },
          "description": "URLs oder Belegstellen. Pflicht, sobald qualitaet 'verifiziert' ist."
        },
        "qualitaet": { "enum": ["verifiziert", "teilgeprueft", "ungeprueft"] },
        "geprueft_am": { "type": "string", "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$" },
        "stand_hinweis": {
          "type": ["string", "null"],
          "description": "womit der Inhalt altern kann, z.B. 'txAdmin-Oberfläche ändert sich häufig'"
        }
      }
    },
    "abschnitt": {
      "type": "object",
      "required": ["titel", "text"],
      "additionalProperties": false,
      "properties": {
        "titel": { "type": "string", "minLength": 2 },
        "text": { "type": "string", "minLength": 10 },
        "schritte": {
          "type": "array",
          "items": { "type": "string" },
          "description": "nummerierte Anleitung, falls es eine Reihenfolge gibt"
        },
        "code": {
          "type": ["string", "null"],
          "description": "Beispielblock, z.B. eine server.cfg-Zeile"
        }
      }
    }
  }
}
